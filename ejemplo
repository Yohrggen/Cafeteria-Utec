render = web.template.render ("views", base = "layout")

class ListaProducto:

    def GET(self):
        productos = self.obtenerProducto()
        return render.productos.lista_producto(productos)
    
    def obtenerProducto(self):
        try:
            conn = sqlite3.connect('sql/ferreteria_shushu.db')
            cursor = conn.cursor()
            query = "SELECT * FROM productos;"
            cursor.execute(query)
            productos = []
            for row in cursor.fetchall():
                producto = {
                    'id_producto': row[0],
                    'nombre_producto': row[1],
                    'precio_producto': row[2],
                    'cantidad_producto': row[3],
                    'marca_producto': row[4]
                }
                productos.append(producto)
            conn.close()
            return productos
        except sqlite3.Error as error:
            print(f"Error 103: {error.args}")
            return[]
        except Exception as error:
            print(f"Error 104: {error.args}")
            return[]
        finally:
            conn.close()

